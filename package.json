{
  "name": "qa-automation-portfolio",
  "version": "1.0.0",
  "description": "Playwright QA automation portfolio — UI (SauceDemo) and API tests",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:chromium": "playwright test --project=chromium",
    "test:dev": "cross-env TEST_ENV=dev playwright test --project=chromium",
    "test:staging": "cross-env TEST_ENV=staging playwright test --project=chromium",
    "test:ui": "playwright test tests/ui --project=chromium",
    "test:api": "playwright test tests/api --project=chromium",
    "report": "playwright show-report"
  },
  "keywords": ["playwright", "qa", "automation", "typescript"],
  "author": "Luka Vidaković",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.10",
    "typescript": "^7.0.2"
  }
}
